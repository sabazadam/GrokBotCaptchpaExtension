# CAPTCHA sağlayıcıları — anahtarlar YALNIZCA backend'de bulunur, ASLA eklentiye gönderilmez.
# Birincil sağlayıcı (zorunlu)
CAPSOLVER_API_KEY=your_capsolver_api_key_here
# CAPSOLVER_BASE_URL=https://api.capsolver.com
# CAPSOLVER_POLL_INTERVAL_MS=2000
# CAPSOLVER_TIMEOUT_MS=120000

# Fallback sağlayıcılar (opsiyonel — sırasıyla denenir: Anti-Captcha, sonra 2Captcha)
# ANTICAPTCHA_API_KEY=your_anticaptcha_key
# TWOCAPTCHA_API_KEY=your_2captcha_key

# Fallback davranışı
# SOLVER_ATTEMPT_TIMEOUT_MS=130000     # sağlayıcı denemesi başına duvar-saati zaman aşımı
# SOLVER_RETRIES_PER_PROVIDER=1        # sağlayıcı başına yeniden deneme
# SOLVER_TOKEN_POLL_INTERVAL_MS=3000   # Anti-Captcha/2Captcha polling aralığı
# SOLVER_TOKEN_TIMEOUT_MS=120000       # Anti-Captcha/2Captcha görev zaman aşımı

# PostgreSQL bağlantısı (üretim).
# Yerelde denemek için BOŞ bırakın; harici Postgres olmadan gömülü (pglite) DB kullanılır.
# DATABASE_URL=postgres://user:pass@localhost:5432/grokbot
# Gömülü DB disk dizini (DATABASE_URL yoksa)
# PGLITE_DATA_DIR=./.data/pglite

# Sunucu
PORT=3000

# Kullanıcı başına limitler
LIMIT_RATE_PER_MINUTE=30
LIMIT_MAX_CONCURRENT=5
LIMIT_DAILY_MAX=5000

# Global bütçe devre kesici (kredi/pencere)
BUDGET_WINDOW_MS=60000
BUDGET_MAX_SPEND=10000

# Lemon Squeezy (opsiyonel — webhook ile kredi yükleme)
# LEMONSQUEEZY_SIGNING_SECRET=your_webhook_signing_secret
# variant_id -> kredi eşlemesi (JSON). Örn: 10 USD paketi = 1000 kredi
# Kredi miktarı YALNIZCA bu eşlemeden okunur. Checkout URL'sindeki
# checkout[custom][credits] alıcı tarafından değiştirilebilir ve yok sayılır.
# LEMONSQUEEZY_VARIANT_CREDITS={"123456":1000,"123457":6000}

# Onboarding / admin
# Admin uçlarını (aktivasyon kodu üretimi, kredi yükleme) korur. Ayarlanmazsa admin uçları kapalı.
# ADMIN_TOKEN=uzun_rastgele_bir_deger
# Kurulum promptunda gösterilecek herkese açık backend adresi
PUBLIC_BACKEND_URL=http://localhost:3000
# Eklentinin kurulum/indirme adresi (Web Store linki veya kurumsal politika notu)
# EXTENSION_URL=https://chrome.google.com/webstore/detail/xxxx
