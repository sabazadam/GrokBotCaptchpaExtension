{
  "name": "grokbot-captcha",
  "version": "0.0.0",
  "private": true,
  "description": "Grok botları için güvenli, kredi bazlı CAPTCHA çözme sistemi (Chrome eklentisi + backend)",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/extension/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:extension": "pnpm --filter @grokbot/extension build"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
